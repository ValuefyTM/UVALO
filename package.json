{
  "name": "valuefy-tools",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3300",
    "build": "next build",
    "lint": "tsc --noEmit",
    "cf:build": "opennextjs-cloudflare build && node scripts/copy-localizare.mjs",
    "cf:deploy": "(wrangler d1 create valuefy-tools-db > /dev/null 2>&1 || true) && wrangler d1 migrations apply DB --remote && opennextjs-cloudflare build && node scripts/copy-localizare.mjs && opennextjs-cloudflare deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@opennextjs/cloudflare": "1.20.6",
    "next": "16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "wrangler": "4.141.0"
  }
}
