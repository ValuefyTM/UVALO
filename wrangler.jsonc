{
	"$schema": "node_modules/wrangler/config-schema.json",
	// tools.valuefy.ro — VALUEFY Tools (SaaS for valuers).
	"name": "tools",
	"main": "worker.ts",
	"compatibility_date": "2026-09-25",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	// Keep the variables set in the Cloudflare dashboard (RESEND_API_KEY, TOOLS_EMAIL_FROM, TOOLS_SUPERADMINS, GOOGLE_MAPS_KEY) on every deploy.
	"keep_vars": true,
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS",
		// Module data (scripts/copy-localizare.mjs): only the worker reads it, for signed-in users with a subscription.
		"run_worker_first": ["/_localizare/*"]
	},
	"d1_databases": [
		{
			// Its own database, separate from the website and the CRM. Created automatically on the first deploy.
			"binding": "DB",
			"database_name": "valuefy-tools-db",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			// Inspecții: photos and documents (CF, floor plans, signatures). Private: served only through /api/inspectii/file/<id>.
			"binding": "FILES",
			"bucket_name": "uvalo-inspectii"
		}
	],
	// Every 15 minutes: the phone reminders of Inspecții (worker.ts → scheduled → /api/m/cron).
	"triggers": { "crons": ["*/15 * * * *"] },
	"observability": { "enabled": true },
	"env": {
		// Staging (the test environment): branch "staging" → GitHub Actions "Deploy" → worker tools-staging. Its own database and
		// bucket; the data is an anonymised copy of production (scripts/db-copy.mjs). Secrets are set on this worker separately.
		"staging": {
			"name": "tools-staging",
			"assets": {
				"directory": ".open-next/assets",
				"binding": "ASSETS",
				"run_worker_first": ["/_localizare/*"]
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "valuefy-tools-staging-db",
					"migrations_dir": "migrations"
				}
			],
			"r2_buckets": [
				{
					"binding": "FILES",
					"bucket_name": "uvalo-inspectii-staging"
				}
			],
			// no reminders from the test environment (the copied data would notify real phones)
			"triggers": { "crons": [] },
			"vars": {
				"APP_ENV": "staging",
				"APP_NAME": "UVALO (test)",
				// custom domains on the worker tools-staging: the platform and the phone app (QR codes, links)
				"APP_URL": "https://test.uvalo.ro",
				"INSP_HOSTS": "inspectii-test.uvalo.ro",
				"INSP_URL": "https://inspectii-test.uvalo.ro",
				// the presentation site and the old domain are not served by the test worker
				"SITE_HOSTS": "",
				"OLD_HOSTS": "",
				"SUPPORT_EMAIL": "office@uvalo.ro",
				// emails to anyone else stay in dev_mail (/dev/mail); these addresses also receive them for real, with "[TEST]"
				"MAIL_ALLOW": "@valuefy.ro,@uvalo.ro",
				// cadastral plans uploaded in staging are converted and published on the "staging" branch, never on main
				"PLANS_GITHUB_BRANCH": "staging"
			},
			"observability": { "enabled": true }
		}
	}
}
